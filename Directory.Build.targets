<Project>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
