{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Lane.Core.Pipeline": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Lane": {
    "Agent": {
      "Persona": "You are Lane. You are curious, dry, and brief. You speak like a person, not an assistant. Do not narrate your actions or offer help you were not asked for.",
      "MaxOutputTokens": 1024,
      "DisplayOffset": "-04:00:00"
    },
    "ResponsePolicy": {
      "Enabled": true,
      "DefaultThreshold": 0.5,
      "Prompt": "Routing",
      "SkipInDirectSessions": true,
      "SetPresence": true,
      "MaxOutputTokens": 1024
    },
    "Sessions": {
      "BatchWindow": "00:00:00.350",
      "MaxConcurrentTurns": 10
    },
    "Prompts": {
      "Directory": "Prompts"
    },
    "Tools": {
      "Allow": [
        "*"
      ],
      "Deny": [],
      "Search": {
        "KeyRef": "env:BRAVE_API_KEY"
      },
      "Books": {
        "Directory": "Books"
      },
      "Identity": {
        "RequireProof": true
      },
      "Mcp": {
        "ConnectTimeout": "00:00:30",
        "ShutdownTimeout": "00:00:02",
        "MaxDescriptionLength": 1024,
        "Servers": []
      }
    },
    "Memory": {
      "Sqlite": {
        "Path": "lane.db"
      },
      "IdleEviction": "00:30:00",
      "FlushInterval": "00:00:10",
      "Handlers": [
        {
          "Id": "recent",
          "Type": "SlidingWindow",
          "Scope": "Session",
          "Slot": "Inline",
          "Order": 0,
          "MaxMessages": 24,
          "Kinds": [
            "Utterance"
          ]
        },
        {
          "Id": "thoughts",
          "Type": "SlidingWindow",
          "Scope": "Global",
          "Slot": "Volatile",
          "Order": 10,
          "Pinned": true,
          "MaxMessages": 5,
          "SectionTitle": "What you have been thinking about",
          "Kinds": [
            "Thought"
          ]
        },
        {
          "Id": "findings",
          "Type": "SlidingWindow",
          "Scope": "Global",
          "Slot": "Stable",
          "Order": 20,
          "Pinned": true,
          "MaxMessages": 8,
          "SectionTitle": "Things you have looked up or read recently",
          "Kinds": [
            "Observation"
          ]
        },
        {
          "Id": "summary",
          "Type": "Summary",
          "Scope": "Session",
          "Slot": "Stable",
          "Order": 5,
          "MaxMessages": 12,
          "PromptName": "Summarize",
          "SectionTitle": "Where this conversation has got to"
        },
        {
          "Id": "profile",
          "Type": "Profile",
          "Scope": "User",
          "Slot": "Stable",
          "Order": 1,
          "MaxMessages": 10,
          "MaxEntries": 12,
          "PromptName": "Profile",
          "SectionTitle": "What you know about them"
        }
      ]
    },
    "Models": {
      "Instances": [
