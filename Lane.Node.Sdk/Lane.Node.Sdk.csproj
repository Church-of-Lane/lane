<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lane.Node.Sdk</RootNamespace>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Lane.Node.Sdk</PackageId>
    <Description>Write a Lane node: lend Lane a model over a WebSocket with reconnection, concurrency, cancellation and signing handled for you.</Description>
    <PackageTags>lane;llm;node;sdk;websocket</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Lane.Core/Lane.Core.csproj" />
    <ProjectReference Include="../Lane.Nodes.Protocol/Lane.Nodes.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lane.Tests" />
  </ItemGroup>

</Project>
