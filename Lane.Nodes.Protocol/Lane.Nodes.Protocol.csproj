<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lane.Nodes.Protocol</RootNamespace>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Lane.Nodes.Protocol</PackageId>
    <Description>The wire protocol spoken between Lane and its nodes: message types, JSON settings and signing.</Description>
    <PackageTags>lane;llm;node;protocol;websocket</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Lane.Core/Lane.Core.csproj" />
  </ItemGroup>

</Project>
