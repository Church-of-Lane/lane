<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lane.Providers</RootNamespace>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Lane.Providers</PackageId>
    <Description>Model providers for Lane: Anthropic, OpenAI-compatible endpoints (OpenRouter, DeepSeek) and TypeSafe System One.</Description>
    <PackageTags>lane;llm;anthropic;openai;openrouter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.11.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Lane.Core/Lane.Core.csproj" />
  </ItemGroup>

  <!-- The message mapper is where provider-shaped bugs hide; the tests need at it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Lane.Tests" />
  </ItemGroup>

</Project>
