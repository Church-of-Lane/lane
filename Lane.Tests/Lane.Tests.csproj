<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Lane.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Features generated by the Kaldi implementation the embedding model was trained
         against, so the port beside it is checked rather than assumed. Fixtures/reference_fbank.py
         regenerates this; nothing in the build runs it. -->
    <EmbeddedResource Include="Fixtures/fbank-reference.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Lane.Core/Lane.Core.csproj" />
    <ProjectReference Include="../Lane.Testing/Lane.Testing.csproj" />
    <ProjectReference Include="../Lane.Providers/Lane.Providers.csproj" />
    <ProjectReference Include="../Lane.Memory/Lane.Memory.csproj" />
    <ProjectReference Include="../Lane.Tools/Lane.Tools.csproj" />
    <ProjectReference Include="../Lane.Tools.Mcp/Lane.Tools.Mcp.csproj" />
    <ProjectReference Include="../Lane.Audio/Lane.Audio.csproj" />
    <ProjectReference Include="../Lane.Surfaces.Discord/Lane.Surfaces.Discord.csproj" />
    <ProjectReference Include="../Lane.Surfaces.Api/Lane.Surfaces.Api.csproj" />
    <ProjectReference Include="../Lane.Surfaces.Coding/Lane.Surfaces.Coding.csproj" />
    <ProjectReference Include="../Lane.Host/Lane.Host.csproj" />
    <ProjectReference Include="../Lane.Nodes/Lane.Nodes.csproj" />
    <ProjectReference Include="../Lane.Node.Sdk/Lane.Node.Sdk.csproj" />
  </ItemGroup>

</Project>
